# Cluster + paper-scale defaults for DPA-Store figure reproduction.
# Source via:  source "$(dirname "$0")/config.env"

REPO="${REPO:-/home/dongshuqi/DPA-Store/dpa-store_branch_default}"
PAPER_REPRO_DIR="${PAPER_REPRO_DIR:-$REPO/scripts/paper_repro}"
OUT_DIR="${OUT_DIR:-$PAPER_REPRO_DIR/out}"
TRACE_WORK_DIR="${TRACE_WORK_DIR:-$OUT_DIR/traces}"
SERVER_LOG_DIR="${SERVER_LOG_DIR:-$OUT_DIR/server_logs}"
CLIENT_LOG_DIR="${CLIENT_LOG_DIR:-$OUT_DIR/client_logs}"

# Roles
SERVER_HOST="${SERVER_HOST:-memserver16}"
CLIENT_HOST="${CLIENT_HOST:-bfhost_72}"
CLIENT_SSH="${CLIENT_SSH:-bfhost_72}"

# Ethernet data plane (must match setup_dataplane scripts / common config)
SERVER_IP="${SERVER_IP:-10.0.1.12}"
SERVER_MAC="${SERVER_MAC:-7c:8c:09:bf:36:73}"
CLIENT_IP="${CLIENT_IP:-10.0.1.11}"
CLIENT_MAC="${CLIENT_MAC:-7c:8c:09:bf:34:39}"
DEV_SERVER="${DEV_SERVER:-mlx5_3}"
# DPDK needs PCI BDF on the client
DEV_CLIENT_PCI="${DEV_CLIENT_PCI:-0000:69:00.1}"

# Traces
BULK_TRACE="${BULK_TRACE:-$REPO/traces/dpastore_bulk.trace}"
READ_TRACE_SRC="${READ_TRACE_SRC:-$REPO/traces/read.trace}"
BULK_INSTALL_PATH="${BULK_INSTALL_PATH:-/tmp/dpastore_bulk.trace}"

# Paper client load (§4.1 / Fig.10): 6 hosts × 31 threads.
# Total in-flight GET  = 6×31×32 = 5952
# Total in-flight WR   = 6×31×18 = 3348
#
# This cluster has 1 client (bfhost_72, 96 CPUs). We keep total in-flight equal
# to the paper by using more threads + deeper per-thread queues:
#   93 threads × 64 inflight = 5952  (GET)
#   93 threads × 36 inflight = 3348  (INSERT/UPDATE/RANGE)
# Fig.10 further scales per-point QD so each X tick matches paper total
# in-flight (see sweep_fig10.sh).
PAPER_NUM_CLIENTS="${PAPER_NUM_CLIENTS:-6}"
PAPER_THREADS_PER_CLIENT="${PAPER_THREADS_PER_CLIENT:-31}"
PAPER_TOTAL_THREADS="${PAPER_TOTAL_THREADS:-$((PAPER_NUM_CLIENTS * PAPER_THREADS_PER_CLIENT))}"  # 186
PAPER_QD_GET="${PAPER_QD_GET:-32}"
PAPER_QD_WRITE="${PAPER_QD_WRITE:-18}"

# 93 workers fit on bfhost_72 (96 CPUs) with headroom for OS + DPDK master lcore.
NUM_SHARD_THREADS="${NUM_SHARD_THREADS:-93}"
# Defaults chosen so NUM_SHARD_THREADS * QD == paper totals (5952 / 3348).
NUM_INFLIGHT_GET="${NUM_INFLIGHT_GET:-64}"
NUM_INFLIGHT_WRITE="${NUM_INFLIGHT_WRITE:-36}"
STARVATION_TIME_US="${STARVATION_TIME_US:-400}"

# Sanity: recompute if user overrides thread count but not QD
if [ "${AUTO_SCALE_INFLIGHT:-1}" = "1" ]; then
  NUM_INFLIGHT_GET=$(( (PAPER_TOTAL_THREADS * PAPER_QD_GET + NUM_SHARD_THREADS - 1) / NUM_SHARD_THREADS ))
  NUM_INFLIGHT_WRITE=$(( (PAPER_TOTAL_THREADS * PAPER_QD_WRITE + NUM_SHARD_THREADS - 1) / NUM_SHARD_THREADS ))
fi

# Ops budget. Default: 2 repeats per point (mean in plot_paper.py).
# Paper used 4/8; override with NUM_RUNS_LONG / NUM_RUNS_SHORT if needed.
# QUICK=1 → tiny ops for wiring checks.
QUICK="${QUICK:-0}"
if [ "$QUICK" = "1" ]; then
  OPS_PER_THREAD_GET="${OPS_PER_THREAD_GET:-80000}"
  OPS_PER_THREAD_WRITE="${OPS_PER_THREAD_WRITE:-40000}"
  NUM_RUNS_LONG="${NUM_RUNS_LONG:-1}"
  NUM_RUNS_SHORT="${NUM_RUNS_SHORT:-1}"
else
  # Keep each point inside the healthy DPA window (~20–40s). Longer runs
  # (2e6 ops/thread ≈ 60s+) trigger DPA RPC Fatal 0x4 and recv collapse.
  OPS_PER_THREAD_GET="${OPS_PER_THREAD_GET:-500000}"
  OPS_PER_THREAD_WRITE="${OPS_PER_THREAD_WRITE:-150000}"
  NUM_RUNS_LONG="${NUM_RUNS_LONG:-2}"
  NUM_RUNS_SHORT="${NUM_RUNS_SHORT:-2}"
fi

# Steady-state window: drop first N and last M seconds of recv/s samples
TRIM_HEAD_S="${TRIM_HEAD_S:-2}"
TRIM_TAIL_S="${TRIM_TAIL_S:-1}"

# Hard wall-clock cap for one client invocation (seconds). 0 = disabled.
CLIENT_MAX_WALL_S="${CLIENT_MAX_WALL_S:-90}"

# DPDK EAL: need master + NUM_SHARD_THREADS workers
DPDK_LCORE_END="${DPDK_LCORE_END:-}"  # auto = NUM_SHARD_THREADS

# Server binaries / rebuild
SERVER_BIN="${SERVER_BIN:-$REPO/server/build/dpastore_host}"
CLIENT_BIN_REMOTE="${CLIENT_BIN_REMOTE:-$REPO/x86_client/build/multiclient}"
SERVER_BUILD_DIR="${SERVER_BUILD_DIR:-$REPO/server/build}"
COMMON_CFG="${COMMON_CFG:-$REPO/common/dpastore_common_config.h}"
TREE_CFG="${TREE_CFG:-$REPO/server/shared/tree_config.h}"
SERVER_CFG="${SERVER_CFG:-$REPO/server/shared/server_config.h}"
DPA_OPS_H="${DPA_OPS_H:-$REPO/server/device/dpa_learned_tree_ops.h}"

# Default paper server knobs
DEFAULT_TRAVERSERS=176
DEFAULT_PATCHERS=4
DEFAULT_STITCHERS=4

# Zipf (paper α=0.99; code often uses 1.1 — keep paper value for Fig.11)
ZIPF_ALPHA="${ZIPF_ALPHA:-0.99}"

# pkg-config paths
export PKG_CONFIG_PATH_SERVER="${PKG_CONFIG_PATH_SERVER:-/opt/mellanox/doca/lib/x86_64-linux-gnu/pkgconfig:/opt/mellanox/flexio/lib/pkgconfig}"
export PKG_CONFIG_PATH_CLIENT="${PKG_CONFIG_PATH_CLIENT:-/opt/mellanox/dpdk/lib/x86_64-linux-gnu/pkgconfig}"

mkdir -p "$OUT_DIR" "$TRACE_WORK_DIR" "$SERVER_LOG_DIR" "$CLIENT_LOG_DIR"
